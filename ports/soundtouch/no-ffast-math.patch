--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -12,6 +12,13 @@
   list(APPEND COMPILE_OPTIONS -Wall -Wextra -Wzero-as-null-pointer-constant -Wno-unknown-pragmas)
   if(EMSCRIPTEN)
     list(APPEND COMPILE_OPTIONS -O3)
+  elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
+    # On Linux, -ffast-math makes the glibc headers map exp/exp2 on to the
+    # __exp_finite/__exp2_finite symbols, which glibc exports only under a
+    # non-default version node: the resulting unversioned references only
+    # bind on the glibc that built them.  Drop -ffast-math (keep -O3) so
+    # SoundTouch links on any glibc >= 2.28.
+    list(APPEND COMPILE_OPTIONS -O3)
   else()
     # Apply -ffast-math to allow compiler autovectorization generate effective SIMD code for arm compilation
     list(APPEND COMPILE_OPTIONS -O3 -ffast-math)
